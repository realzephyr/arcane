# =============================================================================
# Arcane configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Real environment variables always take precedence over values in `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# `development` enables more verbose defaults; `production` is the safe default.
ARCANE_ENV=production
ARCANE_LOG_LEVEL=INFO
# Leave empty to log to the console only.
ARCANE_LOG_FILE=logs/arcane.log

# -----------------------------------------------------------------------------
# Bots
# -----------------------------------------------------------------------------
# Comma-separated personality ids to run. Each one becomes its own Discord bot
# and needs its own token (see below). Personalities live in arcane/personalities/.
ARCANE_BOTS=mp3

# Per-bot settings use the pattern ARCANE_BOT_<PERSONALITY_ID>_<SETTING>.
# Discord bot token for mp3 (Developer Portal -> your app -> Bot -> Reset Token).
ARCANE_BOT_MP3_TOKEN=
# Optional: model override for this bot only (defaults to the personality's model,
# then to ARCANE_OLLAMA_MODEL).
# ARCANE_BOT_MP3_MODEL=
# Optional: channel lists for this bot only (override the global lists below).
# ARCANE_BOT_MP3_ALLOWED_CHANNEL_IDS=
# ARCANE_BOT_MP3_INITIATIVE_CHANNEL_IDS=

# -----------------------------------------------------------------------------
# Channels & behaviour (apply to every bot unless overridden per bot)
# -----------------------------------------------------------------------------
# Comma-separated channel ids the bots may listen and talk in.
# Empty = every channel the bot can see.
ARCANE_ALLOWED_CHANNEL_IDS=
# Comma-separated channel ids where bots may START conversations on their own.
# Empty = never start conversations unprompted.
ARCANE_INITIATIVE_CHANNEL_IDS=
ARCANE_INITIATIVE_ENABLED=true
ARCANE_RESPOND_IN_DMS=true
# Human-like typing indicators and delays. Set to false while developing.
ARCANE_HUMANIZE=true
# Optional override of the personality's conversation timeout, in seconds.
# ARCANE_CONVERSATION_TIMEOUT_SECONDS=240

# -----------------------------------------------------------------------------
# AI backend (Ollama)
# -----------------------------------------------------------------------------
ARCANE_AI_PROVIDER=ollama
ARCANE_OLLAMA_BASE_URL=http://localhost:11434
ARCANE_OLLAMA_MODEL=llama3.1:8b
ARCANE_OLLAMA_TIMEOUT_SECONDS=120
# How long Ollama keeps the model loaded between requests.
ARCANE_OLLAMA_KEEP_ALIVE=30m
# Ollama usually processes one request at a time; raise this only if you have
# configured OLLAMA_NUM_PARALLEL on the server.
ARCANE_OLLAMA_MAX_CONCURRENT_REQUESTS=1
ARCANE_OLLAMA_MAX_RETRIES=2
# Set to false to disable "thinking" on reasoning models (qwen3, deepseek-r1).
# Leave unset for models without a thinking mode.
# ARCANE_OLLAMA_THINK=false

# -----------------------------------------------------------------------------
# Storage & memory
# -----------------------------------------------------------------------------
ARCANE_DATABASE_PATH=data/arcane.db
# Short-term messages older than this are deleted.
ARCANE_SHORT_TERM_TTL_HOURS=24
# Hard cap on stored messages per channel (oldest are deleted first).
ARCANE_MAX_MESSAGES_PER_CHANNEL=300
# How often expired conversations and messages are cleaned up.
ARCANE_MAINTENANCE_INTERVAL_SECONDS=300
# Extract durable facts about users when conversations end.
ARCANE_LONG_TERM_MEMORY_ENABLED=true
